{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "electron.vite.config.ts", "vitest.config.ts"]
}
