/**
 * @file Common mathematical constants for shaders.
 * This file is intended to be included in other shaders to provide
 * commonly used mathematical values.
 * @author Cyril Tarriet
 */

/** The value of Pi (approximately 3.14159265359). */
const PI: f32 = 3.14159265359;
/** The inverse of Pi. */
const INV_PI: f32 = 1.0 / PI;
/** The inverse of two times Pi. */
const INV_2PI: f32 = 1.0 / (2.0 * PI);
