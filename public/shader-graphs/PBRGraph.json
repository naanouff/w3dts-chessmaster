{
  "id": "StandardPBR",
  "properties": {
    "baseColor": { "type": "vec4f", "defaultValue": [1, 1, 1, 1], "name": "Albedo" },
    "roughness": { "type": "f32", "defaultValue": 0.5, "name": "Roughness" },
    "metallic": { "type": "f32", "defaultValue": 0.0, "name": "Metallic" },
    "ior": { "type": "f32", "defaultValue": 1.5, "name": "IOR (dielectric, KHR_materials_ior)" },
    "specularFactor": {
      "type": "f32",
      "defaultValue": 1.0,
      "name": "Specular factor (KHR_materials_specular)"
    },
    "specularColorFactor": {
      "type": "vec3f",
      "defaultValue": [1, 1, 1],
      "name": "Specular color (KHR_materials_specular)"
    },
    "transmissionFactor": {
      "type": "f32",
      "defaultValue": 0.0,
      "name": "Transmission (KHR_materials_transmission)"
    },
    "opacity": { "type": "f32", "defaultValue": 1.0, "name": "Opacity" },
    "anisotropy": { "type": "f32", "defaultValue": 0.0, "name": "Anisotropy" },
    "anisotropyRotation": { "type": "f32", "defaultValue": 0.0, "name": "Anisotropy Rotation" },
    "alphaCutoff": { "type": "f32", "defaultValue": 0.5, "name": "Cutoff" },
    "emissiveColor": { "type": "vec4f", "defaultValue": [0, 0, 0, 1], "name": "Emissive Color" },
    "normalScale": { "type": "f32", "defaultValue": 1.0, "name": "Normal Scale" },

    "baseColorTexture": { "type": "texture_2d", "defaultValue": null, "name": "Albedo Map" },
    "normalTexture": { "type": "texture_2d", "defaultValue": null, "name": "Normal Map" },
    "emissiveTexture": { "type": "texture_2d", "defaultValue": null, "name": "Emissive Map" },
    "metallicRoughnessTexture": { "type": "texture_2d", "defaultValue": null, "name": "ORM Map" },
    "ormAoUvSet": {
      "type": "f32",
      "defaultValue": 0,
      "name": "ORM occlusion samples TEXCOORD_1 (0=no, 1=yes)"
    },
    "ormMrUvSet": {
      "type": "f32",
      "defaultValue": 0,
      "name": "ORM metallic/roughness samples TEXCOORD_1 (0=no, 1=yes)"
    },
    "anisotropyTexture": { "type": "texture_2d", "defaultValue": null, "name": "Anisotropy Map" },
    "transmissionTexture": {
      "type": "texture_2d",
      "defaultValue": null,
      "name": "Transmission map (KHR_materials_transmission, R)"
    },
    "specularTexture": {
      "type": "texture_2d",
      "defaultValue": null,
      "name": "Specular intensity map (KHR_materials_specular, A)"
    },
    "specularColorTexture": {
      "type": "texture_2d",
      "defaultValue": null,
      "name": "Specular color map (KHR_materials_specular, RGB)"
    },
    "pbrDebugAnisoTex": {
      "type": "f32",
      "defaultValue": 0.0,
      "name": "Debug: show anisotropy map (0=off, 1=RGB)"
